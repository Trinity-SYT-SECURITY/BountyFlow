# ============================================================
# BountyFlow Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env_example .env
#
# This single file controls ALL settings for BountyFlow.
# ============================================================


# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=sqlite+aiosqlite:///./bountyflow.db


# ============================================================
# SECURITY
# ============================================================
# IMPORTANT: Change this to a random string in production!
SECRET_KEY=your-secret-key-here-change-in-production


# ============================================================
# DEVELOPMENT MODE
# ============================================================
DEBUG=true
RELOAD=true


# ============================================================
# AI PROVIDER — Fill in ONE key. Auto-detection handles the rest.
# ============================================================
# The platform automatically uses whichever key is set.
# Priority order: Gemini → OpenAI → Anthropic
# To force a specific provider, uncomment: AI_PROVIDER=gemini

# --- Option 1: Google Gemini (Recommended) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_TEMPERATURE=0.7

# --- Option 2: OpenAI GPT ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4
# OPENAI_TEMPERATURE=0.7

# --- Option 3: Anthropic Claude ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Force a specific provider (optional):
# AI_PROVIDER=gemini   # or: openai, anthropic


# ============================================================
# NEO4J — Must match the value in docker-compose.yml
# ============================================================
# Start Neo4j with: docker-compose up -d neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=bountyflow123


# ============================================================
# REDIS — Optional caching (starts with docker-compose up -d)
# ============================================================
# REDIS_URL=redis://localhost:6379
